# Copy to .env and fill with your own backend project values. Only public/publishable values belong here.
# Never put service-role keys, database passwords or other privileged secrets in this file.
VITE_SUPABASE_URL=https://<your-project>.example
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-id>
SUPABASE_URL=https://<your-project>.example
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_PROJECT_ID=<project-id>
# Local demo only (bun run demo sets it itself). Any build with this set fails on purpose.
# ITALIA_LOCAL_DEMO=1
